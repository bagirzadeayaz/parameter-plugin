{
  "mcpServers": {
    "kontakt_parameter": {
      "title": "Kontakt Parameter",
      "description": "Codex-native product research with authenticated Kontakt task storage.",
      "cwd": ".",
      "command": "node",
      "args": ["./mcp/server.mjs", "--stdio"],
      "default_tools_approval_mode": "approve",
      "tools": {
        "begin_parameter_sign_in": { "approval_mode": "prompt" },
        "sign_out_parameter_account": { "approval_mode": "prompt" },
        "start_product_search": { "approval_mode": "prompt" },
        "rerun_product_search": { "approval_mode": "prompt" },
        "cancel_product_search": { "approval_mode": "prompt" },
        "save_product_search_result": { "approval_mode": "prompt" }
      },
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 150,
      "env_vars": ["HOME", "USERPROFILE", "CODEX_HOME"]
    }
  }
}
